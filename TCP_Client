import socket

def start_client():
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect(('127.0.0.1', 5004))
    
    text = input("Enter a string: ")
    client.send(text.encode())
    
    print(f"Length of string: {client.recv(1024).decode()}")
    client.close()

if __name__ == '__main__':
    start_client()
